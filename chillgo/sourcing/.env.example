# CJ Dropshipping Open API (API 2.0) credentials — Section 3, step 2.
# Generate the API key in your CJ account under "API / Developer".
# Copy this file to .env and fill in real values, or export them in your shell.
# NEVER commit the real .env — it is gitignored.

CJ_EMAIL=you@example.com
CJ_API_KEY=your-cj-api-key

# Optional: override the API base (defaults to the production API 2.0 host).
# Point this at the documented sandbox host to validate the flow before hitting
# production data (Section 4.1).
# CJ_API_BASE=https://developers.cjdropshipping.com/api2.0/v1
