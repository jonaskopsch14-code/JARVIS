{%- comment -%}
  ChillGo social proof (Section 5.2 #6): imported reviews with photos.
  Day-to-day this is rendered by your chosen reviews app (Loox / Judge.me / etc.
  — verify current App Store ratings before installing, Section 2). Most of
  those apps expose an "app block" you drop into this section from the editor.
  Until that's wired, the manual highlight blocks below give you real,
  photo-review-style social proof to launch with. Never fabricate reviews —
  only use ones actually imported from the CJ/AliExpress listing.
{%- endcomment -%}
<link rel="stylesheet" href="{{ 'chillgo.css' | asset_url }}" media="all">

<section class="chillgo-section chillgo-social">
  <h2>{{ section.settings.heading }}</h2>

  {%- comment -%} App block slot: add your reviews app block here in the editor. {%- endcomment -%}
  {%- for block in section.blocks -%}
    {%- case block.type -%}
      {%- when '@app' -%}
        {% render block %}
      {%- when 'highlight' -%}
        <figure style="border:1px solid rgba(18,18,18,0.12);border-radius:var(--chillgo-radius);padding:1rem;margin:0;">
          {%- if block.settings.image -%}
            <img src="{{ block.settings.image | image_url: width: 400 }}" alt="Customer photo" loading="lazy" style="width:100%;border-radius:8px;margin-bottom:0.75rem;">
          {%- endif -%}
          <div aria-label="{{ block.settings.stars }} out of 5">{% for i in (1..block.settings.stars) %}★{% endfor %}{% for i in (block.settings.stars..4) %}{% unless forloop.first %}☆{% endunless %}{% endfor %}</div>
          <blockquote style="margin:0.5rem 0 0;font-style:italic;">{{ block.settings.quote }}</blockquote>
          <figcaption style="opacity:0.7;font-size:0.85rem;margin-top:0.5rem;">— {{ block.settings.name }}</figcaption>
        </figure>
    {%- endcase -%}
  {%- endfor -%}
</section>

<style>
  .chillgo-social .chillgo-social__grid,
  .chillgo-social { }
  @media (min-width: 750px) {
    .chillgo-social { display:block; }
  }
</style>

{% schema %}
{
  "name": "ChillGo social proof",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Real people, real cool" }
  ],
  "blocks": [
    { "type": "@app" },
    {
      "type": "highlight",
      "name": "Manual review highlight",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Customer photo" },
        { "type": "range", "id": "stars", "label": "Stars", "min": 1, "max": 5, "step": 1, "default": 5 },
        { "type": "textarea", "id": "quote", "label": "Review quote" },
        { "type": "text", "id": "name", "label": "Name", "default": "Verified buyer" }
      ]
    }
  ],
  "presets": [{ "name": "ChillGo social proof" }]
}
{% endschema %}
