{%- comment -%}
  ChillGo Meta + TikTok pixel base code (Section 5.4 / Section 2).

  PREFERRED PATH: install both pixels via Shopify's native settings instead of
  this snippet —
    - Meta:   Settings > Customer events  (or the Facebook & Instagram app)
    - TikTok: the TikTok for Business app  (Settings > Customer events)
  Native install routes events through Shopify's consent API, which is what
  keeps you DSGVO-compliant (Section 8): pixels only fire after the visitor
  accepts marketing cookies. That matters even at €0 ad spend, because you're
  building retargeting/algorithm data for later.

  Use THIS snippet only as a fallback if you must hardcode the base pixels.
  If you do, gate it on consent so it doesn't fire before the visitor opts in:
    {% raw %}{% if request.design_mode == false %}{% endif %}{% endraw %}
  and set the two IDs in theme settings (schema settings referencing these).
  Render in <head>: {% render 'chillgo-pixels' %}
{%- endcomment -%}

{%- assign meta_id = settings.meta_pixel_id | default: '' -%}
{%- assign tiktok_id = settings.tiktok_pixel_id | default: '' -%}

{%- if meta_id != blank and settings.pixels_via_snippet -%}
  <!-- Meta Pixel (fallback hardcode — prefer Customer events) -->
  <script>
    if (window.Shopify && Shopify.customerPrivacy && !Shopify.customerPrivacy.userCanBeTracked()) {
      // Visitor has not consented to marketing — do not load the pixel.
    } else {
      !function(f,b,e,v,n,t,s){if(f.fbq)return;n=f.fbq=function(){n.callMethod?
      n.callMethod.apply(n,arguments):n.queue.push(arguments)};if(!f._fbq)f._fbq=n;
      n.push=n;n.loaded=!0;n.version='2.0';n.queue=[];t=b.createElement(e);t.async=!0;
      t.src=v;s=b.getElementsByTagName(e)[0];s.parentNode.insertBefore(t,s)}(window,
      document,'script','https://connect.facebook.net/en_US/fbevents.js');
      fbq('init', {{ meta_id | json }});
      fbq('track', 'PageView');
    }
  </script>
{%- endif -%}

{%- if tiktok_id != blank and settings.pixels_via_snippet -%}
  <!-- TikTok Pixel (fallback hardcode — prefer TikTok Customer events) -->
  <script>
    if (window.Shopify && Shopify.customerPrivacy && !Shopify.customerPrivacy.userCanBeTracked()) {
      // No marketing consent — skip.
    } else {
      !function(w,d,t){w.TiktokAnalyticsObject=t;var ttq=w[t]=w[t]||[];
      ttq.methods=["page","track","identify","instances","debug","on","off","once","ready","alias","group","enableCookie","disableCookie"];
      ttq.setAndDefer=function(t,e){t[e]=function(){t.push([e].concat(Array.prototype.slice.call(arguments,0)))}};
      for(var i=0;i<ttq.methods.length;i++)ttq.setAndDefer(ttq,ttq.methods[i]);
      ttq.instance=function(t){for(var e=ttq._i[t]||[],n=0;n<ttq.methods.length;n++)ttq.setAndDefer(e,ttq.methods[n]);return e};
      ttq.load=function(e,n){var r="https://analytics.tiktok.com/i18n/pixel/events.js";ttq._i=ttq._i||{},ttq._i[e]=[],ttq._i[e]._u=r,ttq._t=ttq._t||{},ttq._t[e]=+new Date,ttq._o=ttq._o||{},ttq._o[e]=n||{};var o=d.createElement("script");o.type="text/javascript",o.async=!0,o.src=r+"?sdkid="+e+"&lib="+t;var a=d.getElementsByTagName("script")[0];a.parentNode.insertBefore(o,a)};
      ttq.load({{ tiktok_id | json }});
      ttq.page();
      }(window,document,'ttq');
    }
  </script>
{%- endif -%}
