# =============================================================================
# KI-Mitarbeiter — Umgebungsvariablen (Beispiel)
# Kopiere diese Datei zu ".env" und trage die echten Werte ein.
# NIEMALS die echte .env committen (steht in .gitignore).
# =============================================================================

# --- n8n Weboberfläche (Basic Auth) ---
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=BITTE-STARKES-PASSWORT-SETZEN

# --- Öffentliche Domain für n8n (DNS -> Server-IP) ---
# Beispiel: n8n.deinedomain.de
N8N_HOST=n8n.[DEINE-DOMAIN]

# --- Anthropic (Claude Haiku 4.5) ---
# Key aus console.anthropic.com; Modell in den Workflows: claude-haiku-4-5
ANTHROPIC_API_KEY=sk-ant-XXXXXXXXXXXXXXXXXXXXXXXX

# --- Telegram Bot (via @BotFather) ---
TELEGRAM_BOT_TOKEN=123456789:XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
# Chat-ID deines eigenen Chats mit dem Bot (siehe README, Schritt "Chat-ID ermitteln")
TELEGRAM_CHAT_ID=123456789

# --- Gmail OAuth (in n8n als Credential hinterlegt, hier nur als Referenz) ---
# Die OAuth-Verbindung wird direkt in der n8n-UI eingerichtet (Gmail-Node ->
# "Connect my account"). Client-ID/Secret ggf. aus Google Cloud Console.
GMAIL_OAUTH_CLIENT_ID=[OPTIONAL-falls-eigene-OAuth-App]
GMAIL_OAUTH_CLIENT_SECRET=[OPTIONAL-falls-eigene-OAuth-App]

# --- Website, die überwacht werden soll ---
WEBSITE_URL=https://[DEINE-DOMAIN]
