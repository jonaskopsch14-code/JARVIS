# =============================================================================
# jonas-business — zentrale Platzhalter für alle API-Keys & Zugänge
# Kopiere diese Datei zu ".env" und trage die echten Werte ein.
# Die echte ".env" NIEMALS committen (steht in .gitignore).
#
# Hinweis: Der KI-Mitarbeiter hat zusätzlich eine eigene .env in ai-employee/.
# =============================================================================

# --- Marke / Domain ---
MARKENNAME=[MARKENNAME]
DOMAIN=[DEINE-DOMAIN]                      # z. B. steuer-cockpit.de

# --- Lemon Squeezy (Zahlung / Merchant of Record) ---
LEMONSQUEEZY_STORE=[STORE]                 # Subdomain deines LS-Stores
LEMONSQUEEZY_PRODUCT_ID=[PRODUKT-ID]
LEMONSQUEEZY_API_KEY=[OPTIONAL-fuer-API]

# --- Impressum-Service (ladungsfähige c/o-Adresse) ---
IMPRESSUM_SERVICE=[z.B. Autorenglück / Postflex / ZERODOX / Adressgeber]
LADUNGSFAEHIGE_ANSCHRIFT=[Straße Hausnr., PLZ Ort]
KONTAKT_EMAIL=[E-MAIL]

# --- Anthropic (Claude Haiku 4.5 — KI-Mitarbeiter) ---
ANTHROPIC_API_KEY=sk-ant-XXXXXXXXXXXXXXXXXXXXXXXX

# --- Telegram (Benachrichtigungen) ---
TELEGRAM_BOT_TOKEN=123456789:XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
TELEGRAM_CHAT_ID=123456789

# --- Hetzner / n8n ---
N8N_HOST=n8n.[DEINE-DOMAIN]
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=BITTE-STARKES-PASSWORT-SETZEN
WEBSITE_URL=https://[DEINE-DOMAIN]

# --- Werbung ---
PINTEREST_TAG_ID=[OPTIONAL]
GOOGLE_ADS_CONVERSION_ID=[OPTIONAL]
