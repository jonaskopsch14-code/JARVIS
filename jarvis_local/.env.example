# Jarvis-Konfiguration (Umgebungsvariablen). Kopie als .env / im System setzen.

# Datenverzeichnisse
JARVIS_DATA_DIR=~/.jarvis
JARVIS_VAULT_DIR=~/.jarvis/vault

# Lokales LLM (Ollama)
JARVIS_OLLAMA_MODEL=qwen3:8b
JARVIS_OLLAMA_HOST=http://localhost:11434
JARVIS_TEMPERATURE=0.0
JARVIS_NUM_CTX=16384

# Spracheingabe (faster-whisper)
JARVIS_WHISPER_MODEL=large-v3
JARVIS_WHISPER_DEVICE=cuda
# compute_type: "int8" für CPU (Default), "float16" für GPU
JARVIS_WHISPER_COMPUTE=int8

# Sprachausgabe (Piper – deutsche Thorsten-Stimme)
JARVIS_PIPER_MODEL=de_DE-thorsten-high.onnx

# Optional: Cloud-Web-Agent (browser-use)
# ANTHROPIC_API_KEY=sk-ant-...
# OPENAI_API_KEY=sk-...

# Optional: Premium-TTS (ElevenLabs)
# ELEVENLABS_API_KEY=...
